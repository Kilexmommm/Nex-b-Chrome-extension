{
  "manifest_version": 3,
  "name": "nex.b",
  "description": "Espacios de trabajo visuales con accesos, etiquetas y reutilización de pestañas.",
  "version": "1.7.7",
  "key": "",
  "oauth2": {
    "client_id": "1072291004977-kj4e2mskp59eunofuj6j5cjliqu83bom.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "optional_permissions": ["bookmarks"],
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "activeTab",
    "unlimitedStorage",
    "identity",
    "identity.email",
    "clipboardRead"
  ],
  "host_permissions": ["http://*/*", "https://*/*", "https://www.googleapis.com/"],
  "icons": {
    "16": "icons/nex-b-16.png",
    "32": "icons/nex-b-32.png",
    "48": "icons/nex-b-48.png",
    "128": "icons/nex-b-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "nex.b",
    "default_icon": {
      "16": "icons/nex-b-16.png",
      "32": "icons/nex-b-32.png",
      "48": "icons/nex-b-48.png"
    }
  },
  "minimum_chrome_version": "123",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://www.googleapis.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; frame-src 'none'; form-action 'none'"
  }
}
